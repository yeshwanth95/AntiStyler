{
  "input_image": "../outputs/attack/attacked.pt",
  "output_dir": "../outputs/defense",
  "runtime": {
    "seed": 42,
    "deterministic": true,
    "device": "auto",
    "num_threads": 1,
    "cache_dir": "../.cache/torch"
  },
  "detector": {
    "weights": "COCO_V1",
    "checkpoint": null,
    "min_size": 800,
    "max_size": 1333,
    "score_threshold": 0.7
  },
  "attack": {
    "patch_size": 100,
    "position": null,
    "steps": 200,
    "learning_rate": 0.1,
    "target_label": "person",
    "target_boxes": null,
    "target_score_threshold": 0.7,
    "target_selection": "all",
    "loss_weights": {
      "loss_classifier": 1.0,
      "loss_box_reg": 1.0,
      "loss_objectness": 1.0,
      "loss_rpn_box_reg": 1.0
    }
  },
  "defense": {
    "weights": "IMAGENET1K_V1",
    "checkpoint": null,
    "content_layers": [
      "conv_4"
    ],
    "style_layers": [
      "conv_1",
      "conv_2",
      "conv_3",
      "conv_4",
      "conv_5"
