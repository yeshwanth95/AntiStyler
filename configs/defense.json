    "content_weight": 1.0,
    "style_weight": 1000.0,
    "steps": 1,
    "learning_rate": 0.001,
    "image_size": 600,
    "padding": 10,
    "tau": 0.99,
    "mask_threshold": 0.5,
    "dilation_kernel": 11,
